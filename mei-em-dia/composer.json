{
    "name": "mei-em-dia/app",
    "description": "Sistema de gestão financeira simplificada para MEIs.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "lint": "find app routes public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
